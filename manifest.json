{
  "manifest_version": 3,
  "name": "Suno Receipts",
  "version": "0.1.0",
  "description": "Track human creative decisions across Suno projects and export timestamped authorship receipts.",
  "permissions": ["storage", "downloads", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://suno.com/*", "https://*.suno.com/*", "https://chatgpt.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/chatgpt-content.js"],
      "css": ["src/chatgpt-content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Suno Receipts",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
